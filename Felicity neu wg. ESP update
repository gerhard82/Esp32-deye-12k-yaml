    # --- ZELL-DRIFT ---
  - platform: template
    name: "B6 Zell-Drift"
    unit_of_measurement: "V"
    accuracy_decimals: 3
    lambda: |-
      float cells[] = {id(b6_z1).state, id(b6_z2).state, id(b6_z3).state, id(b6_z4).state,
                       id(b6_z5).state, id(b6_z6).state, id(b6_z7).state, id(b6_z8).state,
                       id(b6_z9).state, id(b6_z10).state, id(b6_z11).state, id(b6_z12).state,
                       id(b6_z13).state, id(b6_z14).state, id(b6_z15).state, id(b6_z16).state};
      float max_v = cells[0], min_v = cells[0];
      for (int i = 1; i < 16; i++) {
        if (cells[i] > max_v) max_v = cells[i];
        if (cells[i] < min_v) min_v = cells[i];
      }
      return (max_v - min_v) * 1;
    update_interval: 20s



