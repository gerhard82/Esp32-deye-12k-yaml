    name: "Batterie Gesamt SOC"
    id: total_battery_soc
    unit_of_measurement: "%"
    # Berechnet den Durchschnitt von allen 6 Batterien
    lambda: |-
      return (id(b1_soc).state + id(b2_soc).state + id(b3_soc).state + 
              id(b4_soc).state + id(b5_soc).state + id(b6_soc).state) / 6.0;
