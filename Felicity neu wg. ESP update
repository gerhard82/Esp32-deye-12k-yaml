# 1. Kommunikations-Schnittstelle
uart:
  id: uart_bus
  tx_pin: GPIO17 # DEIN TX PIN (zum MAX485 DI)
  rx_pin: GPIO16 # DEIN RX PIN (zum MAX485 RO)
  baud_rate: 9600
  stop_bits: 1

modbus:
  id: modbus_hub
  uart_id: uart_bus
  send_wait_time: 250ms       # Erhöht: Gibt der Hardware genug Zeit zum Umschalten    

 



# --- MODBUS CONTROLLER (Die 6 Batterien) ---
modbus_controller:
  - id: bat1
    address: 0x01
    modbus_id: modbus_hub
    setup_priority: -10
    update_interval: 30s
    command_throttle: 150ms
  - id: bat2
    address: 0x02
    modbus_id: modbus_hub
    setup_priority: -10
    update_interval: 30s
    command_throttle: 150ms
  - id: bat3
    address: 0x03
    modbus_id: modbus_hub
