                       id(b1_z5).state, id(b1_z6).state, id(b1_z7).state, id(b1_z8).state,
                       id(b1_z9).state, id(b1_z10).state, id(b1_z11).state, id(b1_z12).state,
                       id(b1_z13).state, id(b1_z14).state, id(b1_z15).state, id(b1_z16).state};
      float max_v = cells[0], min_v = cells[0];
      for (int i = 1; i < 16; i++) {
        if (cells[i] > max_v) max_v = cells[i];
        if (cells[i] < min_v) min_v = cells[i];
      }
      return (max_v - min_v) * 1;
    update_interval: 20s



